# Copy this file to .env in deployments/compose/ for local compose runs.
# Do not commit real DSN credentials.

UMODEL_GRAPHSTORE=postgres.age
UMODEL_DSN=postgres://user:password@host.docker.internal:5433/postgres
UMODEL_GRAPH_PREFIX=ws_

UMODEL_SERVER_PORT=8082
UMODEL_WEB_PORT=5174
UMODEL_API_TARGET=http://umodel-server:8080
